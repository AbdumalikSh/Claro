# Use an OpenAI-compatible chat provider (OpenAI, etc.)
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:3b
# Optional semantic embeddings. When unset, the local Node service uses its built-in hashed-token vectorizer.
EMBEDDING_MODEL=

# Or use Ollama locally. Install a chat model and nomic-embed-text before enabling these settings.
# RAG_EMBEDDING_PROVIDER=hash
# RAG_MIN_RELEVANCE_SCORE=0.1
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=
# OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1

# Local persistent PDF files and index (not MongoDB)
RAG_DATA_DIR=server/data/rag
