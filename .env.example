# The one shared visa PDF. Place the prepared document here on the Claro server.
RAG_KNOWLEDGE_PDF=server/data/visa-guide.pdf
RAG_INDEX_PATH=server/data/rag/visa-guide-index.json
RAG_MIN_RELEVANCE_SCORE=0.1

# Ollama runs on the Claro backend host, not on each client's computer.
# The chat and embedding models are pulled onto the Claro host once.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_OPENAI_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
